{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pakkt-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-20",
  "vars": {
    "ENVIRONMENT": "development",
  },
  "r2_buckets": [
    {
      "binding": "PAKKT_UPLOADS",
      "bucket_name": "pakkt-uploads",
      "preview_bucket_name": "pakkt-uploads-preview",
    },
  ],
  "env": {
    "production": {
      "vars": {
        "ENVIRONMENT": "production",
      },
    },
  },
