{
  "info": {
    "name": "Pakkt API - Complete Collection",
    "description": "Comprehensive API testing collection for Pakkt accountability app with dark neobrutalism UI. Includes all endpoints for Users, Packs, Goals, Check-ins, Fines, Jail, Social, and Uploads features.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8787",
      "type": "string",
      "description": "API base URL (local dev)"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string",
      "description": "Supabase JWT token - get from Supabase Auth"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "packId",
      "value": "",
      "type": "string"
    },
    {
      "key": "goalId",
      "value": "",
      "type": "string"
    },
    {
      "key": "checkInId",
      "value": "",
      "type": "string"
    },
    {
      "key": "fineId",
      "value": "",
      "type": "string"
    },
    {
      "key": "jailSessionId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "📋 Setup & Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "✅ Check API health status (no auth required)\n\n**Expected Response:**\n```json\n{\n  \"status\": \"ok\",\n  \"timestamp\": \"2025-10-22T...\",\n  \"version\": \"1.0.0\"\n}\n```"
          }
        },
        {
          "name": "Get Current User Info",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('userId', response.data.userId);",
                  "    console.log('✅ UserId set:', response.data.userId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me"]
            },
            "description": "🔐 Get authenticated user info and auto-set userId variable\n\n**Auto-sets:** `userId` collection variable"
          }
        },
        {
          "name": "Public Feed (Optional Auth Demo)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/feed",
              "host": ["{{baseUrl}}"],
              "path": ["api", "feed"]
            },
            "description": "🔓 Test optional auth endpoint - works with or without token"
          }
        }
      ],
      "description": "Initial setup, health checks, and auth testing"
    },
